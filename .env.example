# ---- AI: answer models (multi-model fallback chain) ----
GEMINI_API_KEY=            # https://aistudio.google.com/apikey  (answers + embeddings)
GROQ_API_KEY=              # https://console.groq.com/keys (free, very fast)
NVIDIA_API_KEY=            # https://build.nvidia.com (free credits)
OPENROUTER_API_KEY=        # https://openrouter.ai/keys (":free" models)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AI_CHAIN=gemini:gemini-3.6-flash,gemini:gemini-3.5-flash,groq:llama-3.3-70b-versatile   (provider:model, comma separated)
AI_TIMEOUT_MS=10000        # per model, while another model is left to try
AI_TOTAL_BUDGET_MS=30000   # whole answer
AI_HEDGE_MS=6000           # start the next model in parallel if the current one is silent this long (0 = off)

# ---- Embeddings (semantic search) ----
# EMBED_CHAIN=gemini:gemini-embedding-001,gemini:gemini-embedding-2   (add ollama:nomic-embed-text for offline)
EMBED_DIMS=768             # 768 is plenty for manuals and keeps the index small
EMBED_BATCH_SIZE=50        # chunks per request; lower it if the free tier rate-limits you

# ---- Library & answers ----
# DOC_RAG_HOME=./.doc-rag  # where the index lives
# ORG_NAME=Acme Support    # used in the assistant's instructions
TOP_K=6                    # passages sent to the model per question
CHUNK_SIZE=1000            # characters per chunk
CHUNK_OVERLAP=150

# ---- HTTP API (doc-rag serve) ----
PORT=3000
# HOST=0.0.0.0             # default 127.0.0.1 (local only)
# API_KEY=change-me        # required on /api/* when set (x-api-key header or Bearer)
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MIN=60
